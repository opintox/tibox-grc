// Reglas de seguridad para el modo "Con celulares" (ver plan de multijugador,
// cosmic-roaming-walrus.md). Cárgalas en Firebase Console → Firestore Database → Reglas,
// reemplazando las que trae por defecto, y publica.
//
// Modelo de confianza: Auth anónima (1 uid estable por navegador/pestaña mientras dure la
// sesión). No hay contraseñas ni cuentas reales — cualquiera con el código de sala puede
// unirse, a propósito (es un ejercicio cooperativo supervisado en vivo por el facilitador).
// Lo que estas reglas evitan es: enumerar salas ajenas, escribir el documento de otro
// participante, que el facilitador de una sala edite la de otro, que alguien se cambie de
// función a mitad de partida (ver roleClaims más abajo), y que un cliente que se salta la UI
// se una a una sala ya iniciada o precargue un voto/respuesta antes de que corresponda.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Facilitador autorizado: correo+contraseña, segundo factor TOTP, correo verificado y en la
    // lista exacta de facilitadores. Firebase firma estos datos en el token, no se pueden
    // falsificar desde el navegador. Es una lista y no "cualquier @tibox.cl" porque el registro
    // está abierto (lo necesitan las sesiones anónimas de los celulares): alguien podría crear
    // una cuenta a nombre de un colega sin cuenta y, si este confirma la verificación, pasaría
    // como facilitador. Mantener alineado con ALLOWED_FACILITATORS en auth/auth-core.js.
    function isFacilitator() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.firebase.sign_in_second_factor == 'totp'
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['opinto@tibox.cl'];
    }

    function roomData(roomCode) {
      return get(/databases/$(database)/documents/rooms/$(roomCode)).data;
    }

    // Quien creó la sala: el único que puede admitir/rechazar participantes y liberar funciones.
    function isRoomFacilitator(roomCode) {
      return request.auth != null && request.auth.uid == roomData(roomCode).facilitatorUid;
    }

    match /rooms/{roomCode} {
      allow get: if request.auth != null;
      allow list: if false; // sin esto, alguien podría listar/enumerar salas ajenas

      // Solo un facilitador autorizado (ver isFacilitator) puede crear salas; los
      // participantes siguen entrando con auth anónima. expiresAt es obligatorio para que la
      // política TTL de Firestore la limpie sola.
      allow create: if isFacilitator()
        && roomCode.matches('^[A-Z0-9]{6}$')
        && request.resource.data.keys().hasOnly(['facilitatorUid', 'status', 'scenarioId', 'roleRoster', 'createdAt', 'expiresAt'])
        && request.resource.data.facilitatorUid == request.auth.uid
        && request.resource.data.status == 'lobby'
        && request.resource.data.roleRoster is list
        && request.resource.data.expiresAt is timestamp;

      // Solo el facilitador que la creó puede modificar su propia sala (ej. pasar a
      // 'in_progress', o publicar currentAct en las Fases 2/3), y no puede traspasarla.
      allow update: if request.auth != null
        && request.auth.uid == resource.data.facilitatorUid
        && request.resource.data.facilitatorUid == resource.data.facilitatorUid;

      allow delete: if false; // se limpian solas por TTL (ver expiresAt), no hace falta borrado manual

      // Un documento por función (roleKey = id), creado la primera vez que alguien la
      // reclama. Es lo que hace atómica la unicidad "una función, un participante": Firestore
      // evalúa la existencia del documento y el permiso de la escritura como una sola
      // operación server-side, así que dos reclamos simultáneos de la misma función no pueden
      // ganar los dos — el segundo choca con "allow update" (ver abajo) porque para ese
      // momento el documento ya existe con otro uid. room.js confirma esto intentando crear
      // este documento ANTES de crear el de participants/{uid}; si falla, la función ya está
      // tomada. No se valida acá que roleKey pertenezca al roleRoster real del escenario
      // (las reglas no pueden recorrer fácilmente un arreglo de mapas) — esa parte sigue
      // siendo un chequeo del lado del cliente en joinRoom(). Solo se puede reclamar mientras
      // la sala existe y sigue en 'lobby': si no, cualquiera con el código podría acaparar
      // todas las funciones de una sala (o reclamar en salas que no existen).
      match /roleClaims/{roleKeyId} {
        allow get, list: if request.auth != null;
        allow create: if request.auth != null
          && roleKeyId.size() <= 100
          && request.resource.data.keys().hasOnly(['uid', 'claimedAt', 'expiresAt'])
          && request.resource.data.uid == request.auth.uid
          && roomData(roomCode).status == 'lobby'
          // una sola función por sesión: quien ya tiene su documento de participante (pendiente,
          // admitido o rechazado) no puede reservar otra
          && !exists(/databases/$(database)/documents/rooms/$(roomCode)/participants/$(request.auth.uid));
        // Solo quien ya tenía este reclamo puede "actualizarlo" (en la práctica, solo pasa si
        // vuelve a intentar tras una falla de red a mitad del join) — cualquier otro uid que
        // llegue después de que el documento ya existe queda bloqueado acá.
        allow update: if request.auth != null
          && request.auth.uid == resource.data.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.keys().hasOnly(['uid', 'claimedAt', 'expiresAt']);
        // El facilitador la libera al rechazar a quien la había reservado (ver rejectParticipant).
        allow delete: if isRoomFacilitator(roomCode);
      }

      match /participants/{uid} {
        // list: el lobby del facilitador y el celular de cada participante necesitan ver
        // el roster completo (quién se unió, qué función tomó) para evitar duplicados.
        allow get, list: if request.auth != null;

        // claimedRoleKey tiene que estar respaldado por un roleClaims/{key} a nombre de este
        // mismo uid: sin esto, un cliente que se salta la UI podría crear su participante con
        // la función de otro y responder por él (la unicidad de roleClaims no serviría de nada).
        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['uid', 'displayName', 'claimedRoleKey', 'joinedAt', 'lastSeen', 'expiresAt', 'status', 'vote', 'answer'])
          && request.resource.data.status == 'pending'
          && request.resource.data.uid == uid
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.displayName.size() <= 60
          && request.resource.data.claimedRoleKey is string
          && get(/databases/$(database)/documents/rooms/$(roomCode)/roleClaims/$(request.resource.data.claimedRoleKey)).data.uid == uid
          && request.resource.data.vote == null
          && request.resource.data.answer == null
          && roomData(roomCode).status == 'lobby';

        // Tres casos, y solo esos:
        // (1) Admisión: el facilitador de la sala escribe `status` ('admitted'/'rejected'),
        //     `codeChecked` (último intento de código revisado) y `attemptBase` ("Nuevo código").
        //     Ningún participante puede admitirse a sí mismo: el código lo compara el navegador
        //     del facilitador y nunca se guarda en Firestore (ver room.js).
        // (2) El propio participante, PENDIENTE, envía un intento de código (`codeAttempt`):
        //     número de intento consecutivo y como máximo 5 por código vigente, para que no se
        //     pueda probar códigos al azar.
        // (3) El propio participante, YA ADMITIDO y con el ejercicio en curso, escribe solo
        //     `vote` y `answer` — nunca la función que reclamó (si pudiera, cualquiera podría
        //     "convertirse" en quien ganó la votación justo antes de responder). `vote`/`answer`
        //     (Fases 2/3) quedan acotados: solo se pueden escribir en la fase que corresponde,
        //     con la forma que espera facilitator.js, y `answer` solo si el uid reclamó la
        //     función a la que le toca responder.
        allow update: if (
          isRoomFacilitator(roomCode)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'codeChecked', 'attemptBase'])
          && (!('status' in request.resource.data.diff(resource.data).affectedKeys())
              || request.resource.data.status in ['admitted', 'rejected'])
          && (!('codeChecked' in request.resource.data.diff(resource.data).affectedKeys())
              || request.resource.data.codeChecked is int)
          && (!('attemptBase' in request.resource.data.diff(resource.data).affectedKeys())
              || request.resource.data.attemptBase is int)
        ) || (
          request.auth != null && request.auth.uid == uid
          && resource.data.status == 'pending'
          && roomData(roomCode).status in ['lobby', 'in_progress']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['codeAttempt'])
          && request.resource.data.codeAttempt.keys().hasOnly(['value', 'n'])
          && request.resource.data.codeAttempt.value is string
          && request.resource.data.codeAttempt.value.size() == 6
          && request.resource.data.codeAttempt.n is int
          && request.resource.data.codeAttempt.n == resource.data.get('codeAttempt', {'n': 0}).get('n', 0) + 1
          && request.resource.data.codeAttempt.n - resource.data.get('attemptBase', 0) <= 5
        ) || (
          request.auth != null && request.auth.uid == uid
          && resource.data.status == 'admitted'
          && roomData(roomCode).status == 'in_progress'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vote', 'answer'])
          && (
            !('vote' in request.resource.data.diff(resource.data).affectedKeys())
            || (
              roomData(roomCode).get('currentAct', {}).get('phase', null) == 'voting'
              && request.resource.data.vote.keys().hasOnly(['actKey', 'roleKey', 'castAt'])
              && request.resource.data.vote.actKey is string
              && request.resource.data.vote.roleKey is string
            )
          ) && (
            !('answer' in request.resource.data.diff(resource.data).affectedKeys())
            || (
              roomData(roomCode).get('currentAct', {}).get('phase', null) == 'answering'
              && resource.data.claimedRoleKey == roomData(roomCode).get('currentAct', {}).get('target', null)
              && request.resource.data.answer.keys().hasOnly(['actKey', 'optionIndex', 'submittedAt'])
              && request.resource.data.answer.actKey is string
              && request.resource.data.answer.optionIndex is int
              && request.resource.data.answer.optionIndex >= 0
              && request.resource.data.answer.optionIndex < 10
            )
          )
        );

        // Al cerrar el ejercicio el facilitador borra a todos los participantes (ver closeRoom).
        allow delete: if isRoomFacilitator(roomCode);
      }
    }
  }
}
